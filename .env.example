# Sites runtime setting: email of the initial authorized store administrator.
# Configure privately through Sites; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=

# Optional one-time mock inventory setup; disabled when absent. Configure only
# through private Sites runtime settings, then remove both and redeploy.
# TOKEN: random 32-byte hexadecimal secret. EXPIRES_AT: ISO UTC, <=24h ahead.
DEMO_INVENTORY_SETUP_TOKEN=
DEMO_INVENTORY_SETUP_EXPIRES_AT=
