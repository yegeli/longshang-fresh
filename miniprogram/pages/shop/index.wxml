<view class="screen"><view class="mode-banner">{{modeLabel}}</view><view wx:if="{{imageError}}" class="note">部分图片暂时无法读取，请稍后刷新。商品和订单信息以文字为准。</view><view wx:if="{{loading}}" class="loading">正在读取好物…</view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="text-button" bindtap="refresh" loading="{{loading}}">重新读取</button><button class="text-button" data-page="mine" bindtap="go">前往我的</button></view><view wx:if="{{!loading && !error}}"><view class="surface shop-intro"><text class="tag">{{shop.preview ? '筹备店铺' : '模拟采购者店铺'}}</text><text class="page-title">{{shop.name}}</text><text class="muted">{{shop.regionLabel}}</text><text class="body-copy">{{shop.description}}</text><text class="body-copy">采购者：{{shop.procurementName}}</text></view><view class="section-title"><text class="heading">店里好物</text><label class="switch-label">只看有货<switch checked="{{inStock}}" bindchange="toggleStock" color="#24654a"/></label></view><view class="search-line"><input value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search" placeholder="在这家店里搜索好物" maxlength="40"/><button bindtap="search">搜索</button></view><view class="filters"><button wx:for="{{categories}}" wx:key="id" class="filter {{category === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseCategory">{{item.label}}</button></view><view class="section-title"><text class="small muted">匹配 {{matchedCount}} 款 / 共 {{count}} 款</text><button wx:if="{{filtered}}" class="text-button" bindtap="all">清空筛选</button></view><view class="product-grid"><view wx:for="{{products}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="openProduct"><image binderror="imageFailed" class="product-image" src="{{item.image}}" mode="aspectFill"/><view class="product-copy"><text class="product-title">{{item.name}}</text><text class="muted small">{{item.origin}}</text><text wx:if="{{item.videoMediaId}}" class="tag media-video-tag">含演示采摘视频</text><view class="price-line"><text class="price">¥{{item.priceText}}</text><text class="muted small">起 · 模拟</text></view></view></view></view><view wx:if="{{!products.length}}" class="empty">暂时没有符合条件的在售好物。</view></view><view class="bottom-space"></view></view>
