<view class="screen"><view class="mode-banner">{{modeLabel}}</view><view wx:if="{{imageError}}" class="note">部分图片暂时无法读取，请稍后刷新。商品和订单信息以文字为准。</view><view wx:if="{{loading}}" class="loading">正在读取好物…</view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="text-button" bindtap="refresh" loading="{{loading}}">重新读取</button><button class="text-button" data-page="mine" bindtap="go">前往我的</button></view><view wx:if="{{!loading && !error}}"><view class="section-title"><text class="page-title">我的订单</text><button class="text-button" bindtap="refresh">刷新</button></view><scroll-view scroll-x class="filter-scroll"><view class="filters"><button class="filter {{filter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">全部 {{allCount}}</button><button class="filter {{filter === 'waiting' ? 'active' : ''}}" data-value="waiting" bindtap="filter">待发货</button><button class="filter {{filter === 'shipped' ? 'active' : ''}}" data-value="shipped" bindtap="filter">待收货</button><button class="filter {{filter === 'received' ? 'active' : ''}}" data-value="received" bindtap="filter">已完成</button><button class="filter {{filter === 'after' ? 'active' : ''}}" data-value="after" bindtap="filter">售后</button></view></scroll-view><view wx:for="{{orders}}" wx:key="id" class="surface" data-page="order" data-id="{{item.id}}" bindtap="go"><view class="section-title"><text class="muted small">{{item.createdText}}</text><text class="status-tag">{{item.statusText}}</text></view><view class="order-product"><image binderror="imageFailed" src="{{item.lines[0].image}}" mode="aspectFill"/><view class="grow"><text class="product-title">{{item.product}}</text><text class="body-copy">共 {{item.quantity}} 份 · 模拟 ¥{{item.totalText}}</text><text class="muted tiny">{{item.id}}</text></view></view><view class="row-end"><text class="text-link">查看订单 →</text></view></view><view wx:if="{{!orders.length}}" class="empty"><text>这里还没有相应的模拟订单</text><button class="secondary" data-page="home" bindtap="go">去逛好物</button></view></view><view class="bottom-space"></view></view>
