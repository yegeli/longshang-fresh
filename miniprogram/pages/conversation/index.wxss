.conversation-context .heading{margin:10rpx 0;overflow-wrap:anywhere}.conversation-context .body-copy{margin-bottom:0}.message-row{margin:32rpx 0;display:flex;flex-direction:column;align-items:flex-start}.message-meta{display:flex;gap:16rpx;color:#7a8473;font-size:21rpx;margin-bottom:10rpx;max-width:100%;flex-wrap:wrap}.message-bubble{padding:24rpx 28rpx;border-radius:6rpx 24rpx 24rpx;background:#fff;border:1rpx solid #e1e7d7;max-width:94%;white-space:pre-wrap;overflow-wrap:anywhere;font-size:28rpx}.own-message{align-items:flex-end}.own-message .message-bubble{background:#e4eedb;border-color:#cedfc0;border-radius:24rpx 6rpx 24rpx 24rpx}.conversation-welcome{text-align:center;padding:40rpx 24rpx}.conversation-status-actions{margin:32rpx 0}.conversation-bottom{height:500rpx;padding-bottom:env(safe-area-inset-bottom)}.conversation-composer{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 28rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dfe7d6;z-index:8}.conversation-input{height:132rpx;min-height:132rpx;padding:16rpx 20rpx;border:1rpx solid #dfe7d7;border-radius:16rpx;background:#f8faf5;width:100%;font-size:29rpx;line-height:1.6;margin-top:12rpx}.composer-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:14rpx}.composer-actions .primary{padding:18rpx 28rpx;min-width:180rpx}.composer-actions .text-button{font-size:23rpx}.message-error{display:block;color:#9b5732;font-size:24rpx;line-height:1.5;margin-bottom:8rpx}.conversation-composer>.small{display:block}.note text{display:block}
