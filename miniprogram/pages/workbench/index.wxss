.management-counts{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.management-counts>view{flex:1;min-width:140rpx;text-align:center;background:#edf3e7;padding:18rpx 8rpx;border-radius:18rpx}.management-counts text{display:block;font-size:22rpx;color:#65765c}.management-counts text:first-child{font-size:38rpx;color:#2c6247;font-weight:650}.management-product{display:flex;gap:20rpx;align-items:center}.management-product image{width:100rpx;height:110rpx;border-radius:14rpx;flex-shrink:0}.management-panel{scroll-margin-top:24rpx}.management-panel .description-input{margin-top:18rpx;height:210rpx}

.management-tabs{min-width:0}.management-tabs .filter{flex:1;width:0;min-width:0;padding:18rpx 8rpx;white-space:normal}
