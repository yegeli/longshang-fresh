<view class="screen">
  <view class="mode-banner">{{modeLabel}}</view><text class="page-title">商家工作台</text>
  <view wx:if="{{loading}}" class="loading">正在核对管理权限…</view>
  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="text-button" bindtap="refresh" disabled="{{processing}}">重新读取最新资料</button></view>
  <view wx:if="{{!loading && !allowed}}" class="surface"><text class="heading">当前账户没有管理权限</text><text class="body-copy">云端采购者由管理员授权。本机模拟只提供买家体验，不生成商家权限。</text><button class="secondary" data-page="mine" bindtap="go">返回我的</button></view>
  <view wx:if="{{!loading && allowed}}">
    <text class="body-copy">{{session.role === 'admin' ? '平台管理员' : session.merchant.name}}{{session.merchant.region ? ' · ' + session.merchant.region : ''}}</text>
    <view class="management-counts"><view wx:if="{{canProducts}}"><text>{{counts.published}}</text><text>在售商品</text></view><view wx:if="{{canProducts}}"><text>{{counts.low}}</text><text>需补库存</text></view><view wx:if="{{canOrders}}"><text>{{counts.waiting}}</text><text>待发货</text></view><view wx:if="{{canOrders}}"><text>{{counts.shipped}}</text><text>待收货</text></view><view wx:if="{{canAfter}}"><text>{{counts.after}}</text><text>待处理售后</text></view></view>
    <view class="filters management-tabs"><button wx:if="{{canProducts}}" class="filter {{tab === 'products' ? 'active' : ''}}" data-tab="products" bindtap="chooseTab">商品与库存</button><button wx:if="{{canOrders}}" class="filter {{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="chooseTab">订单发货</button><button wx:if="{{canAfter}}" class="filter {{tab === 'after' ? 'active' : ''}}" data-tab="after" bindtap="chooseTab">售后处理</button></view>
    <view class="search-line"><input maxlength="80" value="{{tab === 'products' ? productQuery : tab === 'after' ? afterQuery : orderQuery}}" bindinput="search" placeholder="{{tab === 'products' ? '搜商品名称、地区或编号' : '搜订单号、商品或模拟单号'}}"/><button wx:if="{{tab === 'products' ? productQuery : tab === 'after' ? afterQuery : orderQuery}}" bindtap="clearSearch">清空</button></view>
    <scroll-view scroll-x class="filter-scroll">
      <view wx:if="{{tab === 'products'}}" class="filters"><button class="filter {{productFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">全部 {{counts.products}}</button><button class="filter {{productFilter === 'published' ? 'active' : ''}}" data-value="published" bindtap="filter">已上架</button><button class="filter {{productFilter === 'draft' ? 'active' : ''}}" data-value="draft" bindtap="filter">草稿</button><button class="filter {{productFilter === 'offline' ? 'active' : ''}}" data-value="offline" bindtap="filter">已下架</button><button class="filter {{productFilter === 'low' ? 'active' : ''}}" data-value="low" bindtap="filter">需补库存 {{counts.low}}</button><button class="filter {{productFilter === 'unconfigured' ? 'active' : ''}}" data-value="unconfigured" bindtap="filter">未配置 {{counts.unconfigured}}</button></view>
      <view wx:elif="{{tab === 'orders'}}" class="filters"><button class="filter {{orderFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">全部订单</button><button class="filter {{orderFilter === 'waiting' ? 'active' : ''}}" data-value="waiting" bindtap="filter">待发货</button><button class="filter {{orderFilter === 'shipped' ? 'active' : ''}}" data-value="shipped" bindtap="filter">待收货</button><button class="filter {{orderFilter === 'completed' ? 'active' : ''}}" data-value="completed" bindtap="filter">已完成</button><button class="filter {{orderFilter === 'cancelled' ? 'active' : ''}}" data-value="cancelled" bindtap="filter">已取消</button><button class="filter {{orderFilter === 'refunded' ? 'active' : ''}}" data-value="refunded" bindtap="filter">模拟退款完成</button></view>
      <view wx:else class="filters"><button class="filter {{afterFilter === 'submitted' ? 'active' : ''}}" data-value="submitted" bindtap="filter">待处理 {{counts.after}}</button><button class="filter {{afterFilter === 'resolved' ? 'active' : ''}}" data-value="resolved" bindtap="filter">已处理</button><button class="filter {{afterFilter === 'withdrawn' ? 'active' : ''}}" data-value="withdrawn" bindtap="filter">已撤回</button><button class="filter {{afterFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">全部售后</button></view>
    </scroll-view>
    <view wx:if="{{tab === 'products'}}"><text class="small muted">当前显示 {{visibleProducts.length}} 款；任一规格可售库存 ≤5 份列为需补库存。</text><button class="primary wide" data-page="manage-product" bindtap="go">新增模拟商品</button><view wx:for="{{visibleProducts}}" wx:key="id" class="surface"><view class="management-product"><image src="{{item.image}}" mode="aspectFill"/><view class="grow"><text class="heading">{{item.name}}</text><text class="small muted">{{item.region}}</text></view></view><view class="chips"><text class="tag">{{item.status === 'published' ? '已上架' : item.status === 'draft' ? '草稿' : '已下架'}}</text><text class="tag">版本 {{item.version}}</text><text wx:if="{{!item.stock.configured}}" class="tag">尚未配置库存</text></view><view wx:for="{{item.variants}}" wx:for-item="variant" wx:key="id" class="info-row"><text>{{variant.label}}</text><text>¥{{variant.priceText}} · 库存 {{variant.stock}} 份</text></view><button class="secondary wide" data-page="manage-product" data-id="{{item.id}}" bindtap="go">编辑商品、素材与库存</button></view><view wx:if="{{!visibleProducts.length}}" class="empty">{{products.length ? '没有符合搜索和筛选条件的商品。' : '暂无自己的商品，可先新增模拟商品草稿。'}}</view></view>
    <view wx:else><text class="small muted">当前显示 {{visibleOrders.length}} 笔，只显示当前账户获授权的记录。</text><view wx:for="{{visibleOrders}}" wx:key="id" class="surface"><view class="section-title"><text class="heading">{{item.product}}</text><text class="status-tag">{{item.statusText}}</text></view><text class="small break">{{item.id}}</text><text class="body-copy">{{item.quantity}} 份 · ¥{{item.totalText}}</text><text wx:if="{{item.afterSale}}" class="reply">{{item.afterSale.description}} · {{item.afterLabel}}</text><button class="secondary wide" data-id="{{item.id}}" bindtap="selectOrder">查看与处理</button></view><view wx:if="{{!visibleOrders.length}}" class="empty">暂无符合条件的{{tab === 'after' ? '售后' : '订单'}}，可切换筛选或清空搜索。</view></view>
    <view wx:if="{{selected}}" id="order-management-panel" class="surface management-panel"><text class="heading">处理模拟订单</text><text class="small break">{{selected.id}}</text><text class="body-copy">{{selected.statusText}} · ¥{{selected.totalText}}</text><view wx:for="{{selected.lines}}" wx:key="key" class="info-row"><text>{{item.product}} · {{item.label}}</text><text>{{item.quantity}} 份</text></view>
      <view wx:if="{{selected.fulfillment}}" class="note">{{selected.fulfillment.carrier}} · {{selected.fulfillment.tracking}}</view>
      <view wx:if="{{canOrders}}"><text class="field-label">内部订单备注</text><text class="small muted">仅有订单权限的商家可编辑，买家看不到。</text><textarea class="description-input" maxlength="300" value="{{note}}" data-field="note" bindinput="field" disabled="{{processing}}" placeholder="如：模拟包装核对、发货注意事项"/><button class="secondary wide" bindtap="saveNote" loading="{{processing}}" disabled="{{processing}}">保存内部备注</button><view wx:if="{{noteVersion !== selected.version}}" class="note">订单已更新，当前备注草稿仍保留。请核对后读取最新备注再修改。</view><button class="text-button wide" bindtap="reloadNote" disabled="{{processing}}">放弃草稿，重新读取云端备注</button></view>
      <view wx:if="{{selected.canShip}}"><text class="field-label">模拟物流名称</text><input class="input-box" maxlength="40" value="{{carrier}}" data-field="carrier" bindinput="field" disabled="{{processing}}"/><text class="field-label">模拟物流编号</text><input class="input-box" maxlength="80" value="{{tracking}}" data-field="tracking" bindinput="field" disabled="{{processing}}"/><button class="primary wide" data-action="ship" bindtap="operate" loading="{{processing}}" disabled="{{processing}}">保存模拟发货</button></view>
      <view wx:if="{{selected.canResolve}}"><text class="field-label">模拟售后处理意见</text><textarea class="description-input" maxlength="300" value="{{reply}}" data-field="reply" bindinput="field" disabled="{{processing}}"/><button class="primary wide" data-action="resolve" bindtap="operate" loading="{{processing}}" disabled="{{processing}}">模拟售后处理完成</button></view><button class="text-button wide" bindtap="closeOrder" disabled="{{processing}}">关闭处理区</button></view>
    <button wx:if="{{session.role === 'admin'}}" class="secondary wide" data-page="merchants" bindtap="go">管理微信采购者与权限</button><button class="text-button wide" bindtap="refresh" disabled="{{processing}}">重新读取云端资料</button>
  </view><view class="note">当前仅模拟履约，不接支付、真实物流或退款。管理权限和商品、订单归属由服务器逐次校验。</view><view class="bottom-space"></view>
</view>
