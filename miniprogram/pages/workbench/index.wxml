<view class="screen">
  <view class="mode-banner">{{modeLabel}}</view><text class="page-title">商家工作台</text>
  <view wx:if="{{loading}}" class="loading">正在核对管理权限…</view>
  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><button class="text-button" bindtap="refresh" disabled="{{processing}}">重新读取最新资料</button></view>
  <view wx:if="{{!loading && !allowed}}" class="surface"><text class="heading">当前账户没有管理权限</text><text class="body-copy">云端采购者由管理员授权。本机模拟只提供买家体验，不生成商家权限。</text><button class="secondary" data-page="mine" bindtap="go">返回我的</button></view>
  <view wx:if="{{!loading && allowed}}">
    <text class="body-copy">{{session.role === 'admin' ? '平台管理员' : session.merchant.name}} · {{session.merchant.region}}</text>
    <view class="filters"><button wx:if="{{canProducts}}" class="filter {{tab === 'products' ? 'active' : ''}}" data-tab="products" bindtap="chooseTab">商品与库存</button><button wx:if="{{canOrders}}" class="filter {{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="chooseTab">订单发货</button><button wx:if="{{canAfter}}" class="filter {{tab === 'after' ? 'active' : ''}}" data-tab="after" bindtap="chooseTab">售后处理</button></view>
    <view wx:if="{{tab === 'products'}}"><button class="primary wide" data-page="manage-product" bindtap="go">新增模拟商品</button><view wx:for="{{products}}" wx:key="id" class="surface"><text class="heading">{{item.name}}</text><view class="chips"><text class="tag">{{item.status === 'published' ? '已上架' : '草稿 / 已下架'}}</text><text class="tag">版本 {{item.version}}</text></view><view wx:for="{{item.variants}}" wx:for-item="variant" wx:key="id" class="info-row"><text>{{variant.label}}</text><text>¥{{variant.priceText}} · 库存 {{variant.stock}} 份</text></view><button class="secondary wide" data-page="manage-product" data-id="{{item.id}}" bindtap="go">修改价格与库存</button></view><view wx:if="{{!products.length}}" class="empty">暂无自己的商品，可先新增模拟商品草稿，再设置库存并上架。</view></view>
    <view wx:else><view wx:for="{{orders}}" wx:key="id" wx:if="{{tab !== 'after' || item.afterSale}}" class="surface"><view class="section-title"><text class="heading">{{item.product}}</text><text class="status-tag">{{item.statusText}}</text></view><text class="small break">{{item.id}}</text><text class="body-copy">{{item.quantity}} 份 · ¥{{item.totalText}}</text><text wx:if="{{item.afterSale}}" class="reply">{{item.afterSale.description}} · {{item.afterLabel}}</text><button class="secondary wide" data-id="{{item.id}}" bindtap="selectOrder">查看与处理</button></view><view wx:if="{{!orders.length}}" class="empty">暂无可管理的订单。只展示当前账户有权读取的资料。</view></view>
    <view wx:if="{{selected}}" id="order-management-panel" class="surface management-panel"><text class="heading">处理模拟订单</text><text class="small break">{{selected.id}}</text><text class="body-copy">{{selected.statusText}} · ¥{{selected.totalText}}</text><view wx:for="{{selected.lines}}" wx:key="key" class="info-row"><text>{{item.product}} · {{item.label}}</text><text>{{item.quantity}} 份</text></view>
      <view wx:if="{{selected.fulfillment}}" class="note">{{selected.fulfillment.carrier}} · {{selected.fulfillment.tracking}}</view>
      <view wx:if="{{selected.canShip}}"><text class="field-label">模拟物流名称</text><input class="input-box" maxlength="40" value="{{carrier}}" data-field="carrier" bindinput="field"/><text class="field-label">模拟物流编号</text><input class="input-box" maxlength="80" value="{{tracking}}" data-field="tracking" bindinput="field"/><button class="primary wide" data-action="ship" bindtap="operate" loading="{{processing}}" disabled="{{processing}}">保存模拟发货</button></view>
      <view wx:if="{{selected.canResolve}}"><text class="field-label">模拟售后处理意见</text><textarea class="description-input" maxlength="300" value="{{reply}}" data-field="reply" bindinput="field"/><button class="primary wide" data-action="resolve" bindtap="operate" loading="{{processing}}" disabled="{{processing}}">模拟售后处理完成</button></view><button class="text-button wide" bindtap="closeOrder" disabled="{{processing}}">关闭处理区</button></view>
    <button wx:if="{{session.role === 'admin'}}" class="secondary wide" data-page="merchants" bindtap="go">管理微信采购者与权限</button><button class="text-button wide" bindtap="refresh" disabled="{{processing}}">重新读取云端资料</button>
  </view><view class="note">当前仅模拟履约，不接支付、真实物流或退款。管理权限和商品、订单归属由服务器逐次校验。</view><view class="bottom-space"></view>
</view>
