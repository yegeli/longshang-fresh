.order-event{display:flex;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #edf0e8}.order-event:last-child{border-bottom:0;padding-bottom:0}.event-dot{width:16rpx;height:16rpx;flex-shrink:0;border-radius:50%;background:#5e8a5e;margin-top:15rpx}.event-title{display:block;font-weight:600;font-size:28rpx}.order-event .small{display:block;margin-top:6rpx}.order-event .body-copy{margin-bottom:0}
