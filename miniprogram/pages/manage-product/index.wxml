<view class="screen">
  <view class="mode-banner">{{modeLabel}}</view><text class="page-title">商品、素材与库存</text>
  <view wx:if="{{loading}}" class="loading">正在核对商品归属…</view>
  <view wx:if="{{error}}" class="error-box"><text>{{error}}</text><text class="small">保存未确认成功时，先重新读取并核对，不要重复覆盖。</text><button class="text-button" bindtap="reloadProduct" disabled="{{processing || uploading}}">重新读取最新资料</button></view>
  <view wx:if="{{!loading && !allowed}}" class="surface"><text class="heading">当前账户没有商品管理权限</text><button class="secondary" data-page="mine" bindtap="go">返回我的</button></view>
  <view wx:if="{{!loading && allowed && product}}">
    <view wx:if="{{isNew}}" class="surface"><text class="heading">选择模拟商品模板</text><text class="small muted">内置图片和资料仅为示意，保存后归当前采购者管理。先存草稿，再上传素材、配置库存与上架。</text><view class="template-grid"><button wx:for="{{templates}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="template" disabled="{{processing}}">{{item.name}}</button></view></view>
    <text class="heading">{{product.name}}</text><text class="body-copy">{{product.origin}} · 商品版本 {{product.version}}</text>
    <view class="surface">
      <text class="heading">商品资料与价格</text>
      <text class="field-label">商品名称</text><input class="input-box" maxlength="80" value="{{name}}" data-field="name" bindinput="field" disabled="{{processing}}"/>
      <text class="field-label">产地</text><input class="input-box" maxlength="120" value="{{origin}}" data-field="origin" bindinput="field" disabled="{{processing}}"/>
      <text class="field-label">商品介绍</text><textarea class="description-input" maxlength="1000" value="{{summary}}" data-field="summary" bindinput="field" disabled="{{processing}}"/>
      <text class="field-label">小份装价格（元）</text><input class="input-box" type="digit" maxlength="10" value="{{smallPrice}}" data-field="smallPrice" bindinput="field" disabled="{{processing}}"/>
      <text class="field-label">家庭装价格（元）</text><input class="input-box" type="digit" maxlength="10" value="{{familyPrice}}" data-field="familyPrice" bindinput="field" disabled="{{processing}}"/>
      <view class="info-row"><text>对买家上架</text><switch checked="{{published}}" disabled="{{isNew || processing || uploading}}" bindchange="published" color="#28654b"/></view>
      <button class="primary wide" bindtap="saveProduct" loading="{{processing}}" disabled="{{processing || uploading}}">{{isNew ? '先保存模拟草稿' : '保存资料、素材与状态'}}</button>
    </view>
    <view class="surface media-editor">
      <text class="eyebrow">商品素材</text><text class="heading">图片与采摘视频</text>
      <text wx:if="{{isNew}}" class="note">请先点“先保存模拟草稿”，再上传图片或视频。新草稿暂不向买家展示。</text>
      <text class="body-copy">从相册选择或现场拍摄。当前用于模拟演示，请选有权使用的测试素材；内容由上传者提供，不代表平台已核实产地与品质。</text>
      <image wx:if="{{mediaImageUrl}}" class="media-editor-image" src="{{mediaImageUrl}}" mode="aspectFill" bindtap="previewMediaImage" binderror="mediaFailed"/>
      <text class="small muted">{{product.imageMediaId ? '云端商品图片 · 点击放大' : '默认示意图片 · 非景泰实拍'}} · JPEG / PNG / WebP，最多5 MiB</text>
      <view class="media-buttons"><button class="secondary" data-kind="image" bindtap="chooseMedia" disabled="{{isNew || processing || uploading}}">{{product.imageMediaId ? '更换商品图片' : '上传商品图片'}}</button><button class="text-button" bindtap="restoreImage" disabled="{{processing || uploading || !product.imageMediaId}}">恢复默认示意图</button></view>
      <button wx:if="{{product.imageMediaId}}" class="text-button" data-kind="image" bindtap="refreshMediaPreview" loading="{{previewRefreshing === 'image'}}" disabled="{{processing || uploading || previewRefreshing}}">刷新图片预览</button>
      <video wx:if="{{mediaVideoUrl}}" class="harvest-video" src="{{mediaVideoUrl}}" controls show-center-play-btn object-fit="contain" binderror="mediaFailed"/>
      <view wx:else class="video-empty"><text class="quick-symbol">▶</text><text>暂未选择采摘视频</text><text class="small muted">可上传果园介绍、大小对比或分拣演示</text></view>
      <text class="small muted">MP4，最多20 MiB；相册视频最长120秒，现场拍摄最长60秒。当前视频为演示素材。</text>
      <view class="media-buttons"><button class="secondary" data-kind="video" bindtap="chooseMedia" disabled="{{isNew || processing || uploading}}">{{product.videoMediaId ? '更换采摘视频' : '上传采摘视频'}}</button><button class="text-button" bindtap="removeVideo" disabled="{{processing || uploading || !mediaVideoUrl}}">移除视频</button></view>
      <button wx:if="{{product.videoMediaId}}" class="text-button" data-kind="video" bindtap="refreshMediaPreview" loading="{{previewRefreshing === 'video'}}" disabled="{{processing || uploading || previewRefreshing}}">刷新视频预览</button>
      <text class="field-label">视频标题</text><input class="input-box" maxlength="120" value="{{videoTitle}}" data-field="videoTitle" bindinput="field" disabled="{{processing}}"/>
      <text class="field-label">视频来源与内容说明</text><textarea class="description-input media-note-input" maxlength="500" value="{{videoNote}}" data-field="videoNote" bindinput="field" disabled="{{processing}}" placeholder="例如：自制模拟采摘演示，不代表真实供货；说明拍摄者与授权来源"/>
      <view wx:if="{{uploading}}" class="media-upload-state"><text>{{uploadKind === 'image' ? '图片' : '视频'}}{{uploadPhase === 'verifying' ? '已传输100%，云端校验中…' : uploadPercent >= 0 ? '上传进度 ' + uploadPercent + '%' : '正在准备上传…'}}</text><progress wx:if="{{uploadPercent >= 0}}" percent="{{uploadPercent}}" activeColor="#28654b" stroke-width="6"/><text class="small muted">上传完成后，还需保存商品；请保持此页打开。</text><button class="secondary" bindtap="cancelUpload">取消上传</button></view>
      <text wx:if="{{mediaError}}" class="media-error">{{mediaError}}</text><button wx:if="{{mediaRetry && !uploading}}" class="secondary wide" bindtap="retryUpload" disabled="{{processing}}">重试上一次上传</button>
      <text wx:if="{{mediaStatus}}" class="body-copy">{{mediaStatus}}</text>
      <text class="note">{{mediaDirty ? '素材尚未保存。保存商品并上架后，买家才能在其他手机或电脑上看到。' : '上传只暂存素材。点击保存商品并上架后，买家才能看到更新。'}}下架或草稿商品的素材仅供有权限的商家查看。</text>
      <button wx:if="{{!isNew}}" class="primary wide" bindtap="saveProduct" loading="{{processing}}" disabled="{{processing || uploading}}">保存商品与素材</button>
    </view>
    <view wx:if="{{!isNew}}" class="surface">
      <text class="heading">模拟库存批次</text><text class="small muted">库存版本 {{inventory.version}}。未配置的商品可售份数为0，保存不会自动补满历史库存。</text>
      <text class="field-label">小份装当前可售份数</text><input class="input-box" type="number" maxlength="15" value="{{smallStock}}" data-field="smallStock" bindinput="field"/>
      <text class="field-label">家庭装当前可售份数</text><input class="input-box" type="number" maxlength="15" value="{{familyStock}}" data-field="familyStock" bindinput="field"/>
      <text class="field-label">批次编号</text><input class="input-box" maxlength="80" value="{{batchCode}}" data-field="batchCode" bindinput="field"/>
      <text class="field-label">采收日期（选填，YYYY-MM-DD）</text><input class="input-box" maxlength="10" value="{{harvestDate}}" data-field="harvestDate" bindinput="field"/>
      <text class="field-label">批次说明</text><textarea class="description-input" maxlength="300" value="{{note}}" data-field="note" bindinput="field"/>
      <text class="field-label">本次调整原因</text><input class="input-box" maxlength="200" value="{{reason}}" data-field="reason" bindinput="field"/>
      <button class="primary wide" bindtap="saveStock" loading="{{processing}}" disabled="{{processing || uploading}}">保存模拟库存</button>
    </view>
    <button class="text-button wide" bindtap="reloadProduct" disabled="{{processing || uploading}}">重新读取已保存资料</button><button class="text-button wide" data-page="workbench" bindtap="go">返回商家工作台</button>
  </view>
  <view class="note">本页使用模拟资料，不付款。商品资料及素材一起保存，库存另外保存；已有订单的商品快照保持原样。</view><view class="bottom-space"></view>
</view>
