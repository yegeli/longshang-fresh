<view class="screen"><view class="mode-banner">{{modeLabel}}</view><text class="page-title">商品价格与库存</text>
  <view wx:if="{{loading}}" class="loading">正在核对商品归属…</view><view wx:if="{{error}}" class="error-box"><text>{{error}}</text><text class="small">保存未确认成功时，先重新读取并核对，不要重复覆盖。</text><button class="text-button" bindtap="refresh" disabled="{{processing}}">重新读取最新资料</button></view>
  <view wx:if="{{!loading && !allowed}}" class="surface"><text class="heading">当前账户没有商品管理权限</text><button class="secondary" data-page="mine" bindtap="go">返回我的</button></view>
  <view wx:if="{{!loading && allowed && product}}"><view wx:if="{{isNew}}" class="surface"><text class="heading">选择模拟商品模板</text><text class="small muted">内置图片和资料仅为示意，保存后归当前采购者管理。先存草稿，再配置库存与上架。</text><view class="template-grid"><button wx:for="{{templates}}" wx:key="id" class="secondary" data-id="{{item.id}}" bindtap="template" disabled="{{processing}}">{{item.name}}</button></view></view><text class="heading">{{product.name}}</text><text class="body-copy">{{product.origin}} · 商品版本 {{product.version}}</text>
    <view class="surface"><text class="heading">商品资料与价格</text><text class="field-label">商品名称</text><input class="input-box" maxlength="80" value="{{name}}" data-field="name" bindinput="field"/><text class="field-label">产地</text><input class="input-box" maxlength="120" value="{{origin}}" data-field="origin" bindinput="field"/><text class="field-label">商品介绍</text><textarea class="description-input" maxlength="1000" value="{{summary}}" data-field="summary" bindinput="field"/><text class="field-label">小份装价格（元）</text><input class="input-box" type="digit" maxlength="10" value="{{smallPrice}}" data-field="smallPrice" bindinput="field"/><text class="field-label">家庭装价格（元）</text><input class="input-box" type="digit" maxlength="10" value="{{familyPrice}}" data-field="familyPrice" bindinput="field"/><view class="info-row"><text>对买家上架</text><switch checked="{{published}}" disabled="{{isNew || processing}}" bindchange="published" color="#28654b"/></view><button class="primary wide" bindtap="saveProduct" loading="{{processing}}" disabled="{{processing}}">{{isNew ? '先保存模拟草稿' : '保存资料与状态'}}</button></view>
    <view wx:if="{{!isNew}}" class="surface"><text class="heading">模拟库存批次</text><text class="small muted">库存版本 {{inventory.version}}。未配置的商品可售份数为0，保存不会自动补满历史库存。</text><text class="field-label">小份装当前可售份数</text><input class="input-box" type="number" maxlength="15" value="{{smallStock}}" data-field="smallStock" bindinput="field"/><text class="field-label">家庭装当前可售份数</text><input class="input-box" type="number" maxlength="15" value="{{familyStock}}" data-field="familyStock" bindinput="field"/><text class="field-label">批次编号</text><input class="input-box" maxlength="80" value="{{batchCode}}" data-field="batchCode" bindinput="field"/><text class="field-label">采收日期（选填，YYYY-MM-DD）</text><input class="input-box" maxlength="10" value="{{harvestDate}}" data-field="harvestDate" bindinput="field"/><text class="field-label">批次说明</text><textarea class="description-input" maxlength="300" value="{{note}}" data-field="note" bindinput="field"/><text class="field-label">本次调整原因</text><input class="input-box" maxlength="200" value="{{reason}}" data-field="reason" bindinput="field"/><button class="primary wide" bindtap="saveStock" loading="{{processing}}" disabled="{{processing}}">保存模拟库存</button></view>
    <button class="text-button wide" data-page="workbench" bindtap="go">返回商家工作台</button></view><view class="note">本页使用模拟资料，价格以元填写，库存按可售份数记录。商品保存与库存保存分别执行。</view><view class="bottom-space"></view>
</view>
